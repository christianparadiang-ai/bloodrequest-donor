# ==============================================================================
# LIFE DROP: PRODUCTION ENVIRONMENT CONFIGURATION TEMPLATE (.env.production)
# ==============================================================================
# SECURITY RULES:
# - NEVER commit real production secrets or .env.production to version control.
# - Inject these variables directly into your production hosting provider dashboard
#   (e.g., Vercel Project Settings > Environment Variables).
# - Variables starting with NEXT_PUBLIC_ are bundled into client browser code.
# - Variables WITHOUT NEXT_PUBLIC_ are SERVER-ONLY and strictly guarded.
# ==============================================================================

# Environment Tier Specifier
NEXT_PUBLIC_APP_ENV=production
NODE_ENV=production

# ------------------------------------------------------------------------------
# 1. PUBLIC CLIENT-SIDE CONFIGURATION (EXPOSED IN BROWSER BUNDLES)
# ------------------------------------------------------------------------------

# Production Clerk Authentication (From Clerk Dashboard > API Keys [Production Instance])
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_live_your_production_publishable_key

# Clerk Routing Paths
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/dashboard

# Production Supabase PostgreSQL (From Supabase Dashboard > Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://your-production-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your_production_anon_key

# Supabase Storage Private Bucket Name
NEXT_PUBLIC_SUPABASE_STORAGE_BUCKET=medical_prescriptions

# ------------------------------------------------------------------------------
# 2. SERVER-ONLY SECRETS (NEVER EXPOSE TO BROWSER / CLIENT-SIDE CODE)
# ------------------------------------------------------------------------------

# Clerk Backend Secret Key (From Clerk Dashboard > API Keys [Production Instance])
CLERK_SECRET_KEY=sk_live_your_production_secret_key

# Clerk Svix Webhook Signing Secret (From Clerk Dashboard > Webhooks > Endpoint Secret)
# Configured endpoint URL: https://<your-production-domain>/api/webhooks/clerk
CLERK_WEBHOOK_SECRET=whsec_your_production_webhook_signing_secret

# Supabase Service Role Key (From Supabase Dashboard > Project Settings > API > service_role)
# HIGH PRIVILEGE: Used strictly by server-side actions, outbox workers, and audit logging.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your_production_service_role_key

# Supabase Personal Access Token (For automated CI/CD migrations)
# Generate from: https://supabase.com/dashboard/account/tokens
SUPABASE_ACCESS_TOKEN=sbp_your_supabase_management_personal_access_token

# Direct PostgreSQL Connection URI (Optional: for transaction pooler or direct CLI)
# postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true
DATABASE_URL=

# ------------------------------------------------------------------------------
# 3. WORKER & CRON SCHEDULER AUTHENTICATION (SERVER-ONLY)
# ------------------------------------------------------------------------------

# Vercel Cron Secret (Shared secret between Vercel Edge Cron and Life Drop API routes)
# Automatically injected by Vercel when Cron Jobs are enabled, or set manually.
# Must be at least 32 cryptographically random alphanumeric characters.
CRON_SECRET=your_32_plus_char_cryptographically_random_cron_secret
WORKER_SECRET=your_32_plus_char_cryptographically_random_cron_secret

# ------------------------------------------------------------------------------
# 4. DISTRIBUTED RATE LIMITING (UPSTASH REDIS - SERVER-ONLY, OPTIONAL)
# ------------------------------------------------------------------------------
# Used for sliding-window rate limiting across horizontally scaled serverless edge functions.
# If omitted, system safely falls back to local in-memory sliding-window log.
UPSTASH_REDIS_REST_URL=https://your-upstash-redis-endpoint.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_redis_rest_token

# ------------------------------------------------------------------------------
# 5. EXTERNAL NOTIFICATION PROVIDERS (SERVER-ONLY, OPTIONAL UNTIL ENABLED)
# ------------------------------------------------------------------------------

# External Email Dispatcher (e.g. Resend: https://resend.com)
RESEND_API_KEY=re_your_production_resend_api_key

# External SMS Dispatcher (e.g. Twilio: https://twilio.com)
TWILIO_ACCOUNT_SID=AC_your_production_twilio_account_sid
TWILIO_AUTH_TOKEN=your_production_twilio_auth_token
TWILIO_PHONE_NUMBER=+1234567890
