# ==============================================================================
# LIFE DROP: ENVIRONMENT VARIABLES CONFIGURATION TEMPLATE
# ==============================================================================
# Never commit real secrets to version control.
# Copy this file to .env.local and populate with your staging/production keys.

# ------------------------------------------------------------------------------
# 1. CLERK AUTHENTICATION (https://dashboard.clerk.com)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_sample_clerk_key
CLERK_SECRET_KEY=sk_test_sample_clerk_secret_key
CLERK_WEBHOOK_SECRET=whsec_sample_svix_webhook_secret

# Clerk Route Paths
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/requests
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/donor

# ------------------------------------------------------------------------------
# 2. SUPABASE POSTGRESQL & STORAGE (https://supabase.com/dashboard)
# ------------------------------------------------------------------------------
# Browser-safe public endpoint and anonymous public key
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.sample_anon_key

# SERVER-ONLY PRIVILEGED CREDENTIALS (NEVER EXPOSE TO BROWSER CLIENT)
# Used strictly by background webhooks and administrative stored procedures
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.sample_service_role_key
