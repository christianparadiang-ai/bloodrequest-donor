# ==============================================================================
# LIFE DROP: STAGING ENVIRONMENT CONFIGURATION TEMPLATE (.env.staging)
# ==============================================================================
# IMPORTANT:
# - Copy this file to .env.staging (or set these in your cloud hosting provider).
# - Staging MUST use dedicated STAGING infrastructure, NEVER production credentials.
# - DO NOT commit real staging secrets to version control.
# ==============================================================================

# Environment Tier Specifier
NEXT_PUBLIC_APP_ENV=staging
APP_ENV=staging
NODE_ENV=production

# ------------------------------------------------------------------------------
# 1. SUPABASE STAGING CLUSTER (https://supabase.com/dashboard)
# ------------------------------------------------------------------------------
# Staging Supabase Project URL & Anon Key (Client-Safe)
NEXT_PUBLIC_SUPABASE_URL=https://your-staging-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your_staging_anon_key

# Staging Supabase Service Role Key (SERVER-ONLY - NEVER EXPOSE TO CLIENT)
# Used for migration execution, durable outbox dispatch, and audit log ingestion
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your_staging_service_role_key

# Direct PostgreSQL Connection URI (Optional: for direct migration execution via psql)
# postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-STAGING-REF].supabase.co:5432/postgres
DATABASE_URL=

# Staging Storage Bucket Name
NEXT_PUBLIC_SUPABASE_STORAGE_BUCKET=medical-prescriptions

# ------------------------------------------------------------------------------
# 2. CLERK STAGING AUTHENTICATION (https://dashboard.clerk.com)
# ------------------------------------------------------------------------------
# Staging Clerk Keys (Client-Safe Publishable Key + Server-Only Secret Key)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_your_staging_publishable_key
CLERK_SECRET_KEY=sk_test_your_staging_secret_key

# Staging Svix Webhook Signing Secret (From Clerk Dashboard > Webhooks)
# Configured endpoint: https://<your-staging-domain>/api/webhooks/clerk
CLERK_WEBHOOK_SECRET=whsec_your_staging_webhook_secret

# Clerk Staging Routing Paths
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/donor

# ------------------------------------------------------------------------------
# 3. SYNTHETIC STAGING TEST IDENTITIES
# ------------------------------------------------------------------------------
# For manual or automated smoke testing, register the following synthetic test
# users in the staging Clerk application:
#
# - STAGING_REQUESTER:      requester.test@lifedrop.example  (Role: USER)
# - STAGING_DONOR_A:        donor.a@lifedrop.example        (Role: USER, Donor: O+)
# - STAGING_DONOR_B:        donor.b@lifedrop.example        (Role: USER, Donor: O-)
# - STAGING_HOSPITAL_A:     staff.a@hospital-a.example      (Role: HOSPITAL_STAFF, Affiliation: St. Jude Hospital)
# - STAGING_HOSPITAL_B:     staff.b@hospital-b.example      (Role: HOSPITAL_STAFF, Affiliation: Metropolitan General)
# - STAGING_MODERATOR:      moderator.test@lifedrop.example (Role: MODERATOR)
# - STAGING_ADMIN:          admin.test@lifedrop.example     (Role: ADMIN)
